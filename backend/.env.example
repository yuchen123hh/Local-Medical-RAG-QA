# 本文件可以复制为 backend/.env。真实 API Key 建议放在系统环境变量 DASHSCOPE_API_KEY 中。

# 大模型：默认走阿里百炼 DashScope
LLM_TYPE=ALIYUN
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3-max
ALIYUN_MODEL_NAME=qwen3-max

# Embedding：只有上传新文档或手动导入向量库时才会调用。
# 内置医疗语料默认走本地 Markdown 关键词检索，不需要 embedding，不会产生导入费用。
EMBED_MODEL_TYPE=ALIYUN
ALIYUN_EMBED_MODEL_NAME=text-embedding-v4
ALIYUN_EMBED_BATCH_SIZE=10
ALIYUN_EMBED_MAX_RETRIES=3

# PDF 图片理解；不需要多模态时保持默认即可
VISION_MODEL_TYPE=ALIYUN
VISION_CHAT_MODEL_NAME=qwen-vl-max
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# 本地数据库与缓存：无需 MySQL、Redis、Docker
DB_ENGINE=sqlite
SQLITE_DATABASE=data/chat_history.sqlite3
REDIS_BACKEND=memory
RATE_LIMIT_ENABLED=false

# Django 用户服务地址
DJANGO_API_URL=http://127.0.0.1:8011

# 本地医疗语料：随仓库下载，免向量导入
BUILTIN_MEDICAL_CORPUS_ENABLED=true
BUILTIN_MEDICAL_CORPUS_DIR=../docs/rag_test_corpus/split_100k
SHARED_MEDICAL_USER_ID=agYcn9m9kHM9AHaHMEcRby

# 重排序模型不存在时使用轻量关键词排序
SKIP_RERANKER_MODEL_CHECK=true

# 关闭 LangSmith 追踪，减少新手配置项
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medical-rag-local

# JWT：必须与 DjangoUserService/.env 的 JWT_SECRET_KEY 完全一致
SECRET_KEY=MY_JWT_SECRET_KWY_FOR_USR_AND_I_JUST_WRITE_THIS
ALGORITHM=HS256
