# 本文件可以复制为 DjangoUserService/.env

# 必须与 backend/.env 的 SECRET_KEY 完全一致
JWT_SECRET_KEY=MY_JWT_SECRET_KWY_FOR_USR_AND_I_JUST_WRITE_THIS

# 本地即用：默认 SQLite，不需要 MySQL
DB_ENGINE=sqlite
SQLITE_DATABASE=data/user_service.sqlite3

# 本地即用：默认内存缓存，不需要 Redis
REDIS_BACKEND=memory
REDIS_CACHE_URL=redis://localhost:6379/1

# 本项目不依赖后台 Celery 任务，保留内存配置避免新手额外安装服务
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=3600
